# Leave as /api when using nginx/Vite proxy.
VITE_API_BASE=/api

# Local dev only: login via backend (email+password) instead of Supabase. Remove before prod deploy.
VITE_DEV_LOCAL_AUTH=true

# Supabase Auth (email confirmation — no custom SMTP needed)
# Create project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
