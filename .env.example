# Used by docker compose (root). Do not commit real secrets.

POSTGRES_PASSWORD=replace_with_long_random_db_password
SECRET_KEY=replace_with_secrets_token_urlsafe_64
APP_ENV=production
PORT=80

# Public site origins allowed by CORS (frontend URL)
CORS_ORIGINS=https://yourdomain.com
# API hostnames for TrustedHostMiddleware
TRUSTED_HOSTS=yourdomain.com,api.yourdomain.com
PUBLIC_HOST=yourdomain.com

ADMIN_EMAIL=you@yourdomain.com
ADMIN_USERNAME=siteadmin
# min 14 chars: upper, lower, digit, symbol — generate with scripts/gen_secrets.py
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=KeyMaster Admin
ADMIN_SYNC_PASSWORD=false
ACCESS_TOKEN_EXPIRE_MINUTES=720
SEED_ON_STARTUP=true
