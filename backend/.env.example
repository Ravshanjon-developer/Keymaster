# development | production
APP_ENV=development

# Local SQLite (dev only). Production MUST use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./keymaster.db
# DATABASE_URL=postgresql+asyncpg://keymaster:CHANGE_ME@db:5432/keymaster

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production-min-32

# JWT lifetime (minutes). Production tip: 60–1440
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated, no *
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Production hosts (comma-separated). Include your API hostname.
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Admin bootstrap (REQUIRED in production) ---
# Password: min 14 chars, upper + lower + digit + symbol. Never commit real values.
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=siteadmin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=KeyMaster Admin
# Set true once to rotate password from ADMIN_PASSWORD, then set back to false
ADMIN_SYNC_PASSWORD=false

SEED_ON_STARTUP=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_ADMIN_PER_MINUTE=60

# SMTP_USE_TLS=true

# Supabase Auth — Legacy JWT Secret (Settings → JWT Keys → Legacy JWT Secret)
# SUPABASE_JWT_SECRET=your-jwt-secret
# Project URL (helps JWKS if Supabase uses ES256 signing keys)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public site URL (email links if using custom SMTP register)
FRONTEND_URL=http://localhost:5173

# SMTP (optional in dev — link is logged if SMTP_HOST is empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USE_TLS=true
